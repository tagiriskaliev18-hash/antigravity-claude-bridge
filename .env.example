# Copy to .env and fill in the keys you use. .env is gitignored.
# Existing environment variables win over this file.
# The bridge reads keys only from the environment and returns a clear error
# if a selected provider's key is missing. Do not put real keys in git.

XYVERO_API_KEY=
OCTAVAPI_API_KEY=
MULTILLM_API_KEY=

# Optional URL overrides. Defaults live in config/multillm_providers.json.
# XYVERO_BASE_URL=https://xyvero.space/v1
# OCTAVAPI_BASE_URL=https://octavapi.shop/v1
# MULTILLM_BASE_URL=https://api.aikeysforyou.com/v1

# Optional model overrides. Comma-separated ids replace that provider's list.
# MULTILLM_DEFAULT_MODEL=deepseek-v4.1-flash
# MULTILLM_CONFIG=config/multillm_providers.json
# XYVERO_MODELS=deepseek-v4.1-flash
# OCTAVAPI_MODELS=gpt-6-astra,claude-opus-5-5
# MULTILLM_MODELS=deepseek-v4-pro,qwen3.8-flash
