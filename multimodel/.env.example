# Ключи мультимодели. Этот файл копируется в C:\projects\tools\.env при установке.
# Вписывать ключи удобнее командой (ввод скрыт):
#   python C:\projects\tools\claude_bridge.py --keys
# Файл .env остаётся только на этом компьютере и в репозиторий не попадает.

# CheapVibeCode (api.aikeysforyou.com): DeepSeek V4 Pro, Qwen, GLM, MiniMax
CVC_API_KEY=
# CVC_BASE_URL=https://api.aikeysforyou.com/v1

# Xyvero (xyvero.space): DeepSeek V4.1 Flash
XYVERO_API_KEY=
# XYVERO_BASE_URL=https://xyvero.space/v1

# Moonshot AI: Kimi. Если ключ от китайского аккаунта, адрес https://api.moonshot.cn/v1
KIMI_API_KEY=
# KIMI_BASE_URL=https://api.moonshot.ai/v1
# KIMI_MODEL=kimi-latest

# OctavAPI (octavapi.shop): GPT-6 Astra, Claude Opus 5.5
OCTAVAPI_API_KEY=
# OCTAVAPI_BASE_URL=https://octavapi.shop/v1

# Groq: бесплатная Llama 3.3 70B
GROQ_API_KEY=
